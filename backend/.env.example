# ==========================================================
# Dev Whicho - variables de entorno del backend
# Copia este archivo a .env y ajusta los valores.
# ==========================================================

APP_NAME=Dev Whicho
NODE_ENV=development
PORT=7000

# Orígenes permitidos para CORS, separados por coma ("*" = cualquiera)
CORS_ORIGIN=*

# Autenticación
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_IN=30d

# Base de datos: usa DATABASE_URL (Render) o los valores sueltos (local)
# DATABASE_URL=postgres://usuario:password@host:5432/dev_whicho
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dev_whicho
DB_USER=postgres
DB_PASSWORD=12345

# Correo (Resend)
RESEND_API_KEY=
MAIL_FROM=Dev Whicho <onboarding@resend.dev>
ADMIN_EMAIL=

# Archivos (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dev-whicho

# Solo para archivos heredados en disco
UPLOADS_PATH=uploads
